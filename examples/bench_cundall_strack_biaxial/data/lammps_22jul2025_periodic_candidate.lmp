# Independent 2-D DEM reference for the Cundall--Strack-style compression path.
# LAMMPS 22Jul2025; SI units. This is deliberately a separate implementation.
units si
dimension 2
boundary p p p
atom_style sphere
newton off
comm_modify vel yes

region box block 0.0 0.010 0.0 0.014 -0.00035 0.00035
create_box 1 box
create_atoms 1 random 197 1979 box
set type 1 diameter 0.00060 density 2500.0
velocity all set 0.0 0.0 0.0

pair_style gran/hertz/history 7.0e7 NULL 0.70 NULL 0.40 1
pair_coeff * *
timestep 2.0e-7
neighbor 0.00072 bin
neigh_modify every 1 delay 0 check yes

fix integrate all nve/sphere
fix planar all enforce2d
fix damp all viscous 2.0e-5

# Isotropic seating, then prescribed 2-D axial compression.
fix seat all press/berendsen iso 250.0 250.0 2.0e-4
run 4000
unfix seat
reset_timestep 0
variable ly_ref equal ly
variable ly_ref0 equal ${ly_ref}
variable e equal (v_ly_ref0-ly)/v_ly_ref0
variable sxx equal pxx
variable syy equal pyy
thermo 200
thermo_style custom step temp press v_e v_sxx v_syy lx ly atoms
run 0
fix record all print 200 "$(step),$(v_e),$(v_sxx),$(v_syy),$(lx),$(ly)" file lammps_results.csv screen no title "step,axial_strain,sxx,syy,lx,ly"
fix drive all deform 1 y erate -25.0 remap x
run 14000
